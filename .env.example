# Database: local SQLite file, or a Turso database URL in production (libsql://...)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Admin panel login (/admin)
ADMIN_PASSWORD=
# Random string used to sign the admin session (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Vercel Blob token for photo uploads in production (local uploads go to public/uploads)
BLOB_READ_WRITE_TOKEN=

# Optional: email notifications for new orders via Resend
RESEND_API_KEY=
EMAIL_FROM=Soft Home <porosi@yourdomain.com>
NEXT_PUBLIC_SITE_URL=http://localhost:3000
